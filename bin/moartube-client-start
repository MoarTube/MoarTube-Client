#!/usr/bin/env node

import { existsSync, rmSync } from 'node:fs';
import path from 'node:path';
import { fileURLToPath } from 'node:url';
import { createRequire } from 'node:module';
import { spawnSync } from 'node:child_process';

process.title = 'MoarTube Client';

const root = fileURLToPath(new URL('../', import.meta.url));
const clean = process.argv.slice(2).includes('--clean');

try {
  if (clean) {
    // Resolve build prerequisites before removing the existing installation's data.
    if (!existsSync(path.join(root, 'src', 'moartube-client.ts'))) {
      throw new Error('Clean startup requires a source checkout and development dependencies.');
    }
    const require = createRequire(import.meta.url);
    const builder = require.resolve('tsup/dist/cli-default.js');

    for (const name of ['data', 'dist', 'playwright-report', 'temp', 'test-results']) {
      const target = path.resolve(root, name);
      if (path.dirname(target) !== path.resolve(root)) {
        throw new Error(`Cleanup target is outside the client directory: ${target}`);
      }
      console.log(`Removing ${target}`);
      rmSync(target, { recursive: true, force: true });
    }

    const build = spawnSync(process.execPath, [builder], { cwd: root, stdio: 'inherit' });
    if (build.error) throw build.error;
    if (build.status !== 0) {
      throw new Error(`Client build failed (${build.signal ?? build.status}).`);
    }
  }

  await import(new URL('../dist/moartube-client.js', import.meta.url).href);
} catch (error) {
  console.error('Failed to start MoarTube Client:', error);
  process.exitCode = 1;
}
