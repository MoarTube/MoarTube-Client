{
  "name": "@moartube/moartube-client",
  "version": "1.1.0",
  "type": "module",
  "description": "A free, open-source, self-hosted, anonymous, decentralized video/live stream platform. Scalable via Cloudflare, works in the cloud or from home WiFi.",
  "author": "MoarTube, LLC",
  "homepage": "https://www.moartube.com",
  "license": "MIT",
  "main": "dist/moartube-client.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoarTube/MoarTube-Client.git"
  },
  "bin": {
    "moartube-client": "./bin/moartube-client-start"
  },
  "files": [
    "dist",
    "resources/ffmpeg",
    "bin"
  ],
  "keywords": [
    "alternative",
    "youtube",
    "twitch",
    "video",
    "stream",
    "live",
    "moartube"
  ],
  "overrides": {
    "esbuild": ">=0.25.0"
  },
  "engines": {
    "node": ">=24.22.1"
  },
  "scripts": {
    "dev": "tsx watch src/moartube-client.ts",
    "build": "tsup",
    "start": "node bin/moartube-client-start",
    "prepack": "npm run build",
    "prepare": "husky install",
    "desktop:dev": "npm run build && node scripts/desktop.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:prepare:linux": "node scripts/prepare-desktop-linux.mjs",
    "desktop:prepare:darwin": "node scripts/prepare-desktop-darwin.mjs",
    "desktop:prepare:darwin:arm64": "node scripts/prepare-desktop-darwin.mjs --arch=arm64",
    "desktop:build:windows": "npm run build && npm run desktop:prepare && electron-builder --config desktop/electron-builder.cjs --win --x64 --publish never && node scripts/desktop-checksums.mjs",
    "desktop:build:linux": "node scripts/desktop-linux.mjs",
    "desktop:build:linux:arm64": "node scripts/desktop-linux.mjs --arch=arm64",
    "desktop:build:linux:native": "node scripts/desktop-linux-native.mjs",
    "desktop:build:darwin": "node scripts/desktop-darwin.mjs",
    "desktop:build:darwin:arm64": "node scripts/desktop-darwin.mjs --arch=arm64",
    "desktop:pack:windows": "npm run build && npm run desktop:prepare && electron-builder --config desktop/electron-builder.cjs --win --x64 --dir --publish never",
    "desktop:pack:linux:native": "node scripts/desktop-linux-native.mjs --dir",
    "desktop:verify:windows": "node scripts/desktop-smoke.mjs",
    "desktop:verify:linux": "node scripts/verify-desktop-linux.mjs",
    "desktop:verify:linux:arm64": "node scripts/verify-desktop-linux-arm64-vm.mjs",
    "desktop:verify:linux:arm64:native": "node scripts/verify-desktop-linux.mjs --arch=arm64",
    "desktop:verify:linux:arm64:vm": "node scripts/verify-desktop-linux-arm64-vm.mjs",
    "desktop:verify:darwin": "node scripts/verify-desktop-darwin.mjs",
    "desktop:verify:darwin:arm64": "node scripts/verify-desktop-darwin.mjs --arch=arm64",
    "desktop:test": "node --test desktop/tests/*.test.cjs",
    "ffmpeg:build:windows": "node tooling/ffmpeg/scripts/build-windows.mjs",
    "ffmpeg:build:linux": "node tooling/ffmpeg/scripts/build-linux.mjs",
    "ffmpeg:build:linux:arm64": "node tooling/ffmpeg/scripts/build-linux.mjs --arch=arm64",
    "ffmpeg:build:darwin": "node tooling/ffmpeg/scripts/build-darwin.mjs",
    "ffmpeg:build:darwin:arm64": "node tooling/ffmpeg/scripts/build-darwin.mjs --arch=arm64",
    "ffmpeg:package:windows": "node tooling/ffmpeg/scripts/package-windows.mjs",
    "ffmpeg:stage:windows": "node tooling/ffmpeg/scripts/stage-windows.mjs",
    "ffmpeg:verify:windows": "node tooling/ffmpeg/scripts/verify-features.mjs",
    "ffmpeg:verify:software": "node tooling/ffmpeg/scripts/verify-software.mjs",
    "ffmpeg:verify:linux:runtimes": "node tooling/ffmpeg/scripts/verify-linux-runtimes.mjs",
    "ffmpeg:verify:linux:arm64:runtimes": "node tooling/ffmpeg/scripts/verify-linux-runtimes.mjs --arch=arm64",
    "ffmpeg:test:tooling": "node --test tooling/ffmpeg/tests/*.test.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:e2e": "tsc -p tests/e2e/tsconfig.json --noEmit",
    "typecheck:integration": "tsc -p tests/integration/tsconfig.json --noEmit",
    "lint": "eslint src tests --ext .ts",
    "lint:src": "eslint src --ext .ts",
    "lint:tests": "eslint tests --ext .ts",
    "lint:e2e": "eslint tests/e2e --ext .ts",
    "lint:fix": "eslint src tests --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "knip": "knip",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "node --import tsx tests/integration/run.ts all",
    "test:integration:preflight": "node --import tsx tests/integration/run.ts preflight",
    "test:gpu": "node --import tsx tests/integration/run.ts gpu",
    "test:gpu:e2e": "node --import tsx tests/integration/run.ts gpu-e2e",
    "test:runner": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/start-integration-runner.ps1",
    "test:runner:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-integration-runner.ps1",
    "test:memory": "playwright test --config playwright.memory.config.ts",
    "test:watch-page": "playwright test --config playwright.watch.config.ts",
    "test:comments": "playwright test --config playwright.comments.config.ts",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --project=chromium --debug",
    "test:e2e:headed": "playwright test --project=chromium --headed",
    "test:e2e:report": "playwright show-report",
    "test:e2e:install": "playwright install chromium firefox webkit"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.729.0",
    "@aws-sdk/client-sts": "^3.729.0",
    "@aws-sdk/lib-storage": "^3.729.0",
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/formbody": "^8.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/session": "^11.1.1",
    "@fastify/static": "^9.0.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/view": "^11.1.1",
    "@fastify/websocket": "^11.2.0",
    "awilix": "^12.0.5",
    "axios": "^1.7.7",
    "ejs": "^4.0.1",
    "fastify": "^5.7.2",
    "fastify-plugin": "^5.1.0",
    "fastify-type-provider-zod": "^6.1.0",
    "form-data": "^4.0.0",
    "pino": "^10.3.0",
    "pino-pretty": "^13.1.3",
    "portscanner": "^2.2.0",
    "sharp": "^0.33.5",
    "systeminformation": "^5.23.5",
    "ws": "^8.18.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@playwright/test": "^1.64.1",
    "@types/ejs": "^3.1.5",
    "@types/node": "^25.2.0",
    "@types/pino-pretty": "^4.7.5",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.0.18",
    "electron": "45.1.0",
    "electron-builder": "26.18.0",
    "eslint": "^9.39.2",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^17.3.0",
    "husky": "^9.1.7",
    "knip": "^5.82.1",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "vitest": "^4.0.18"
  }
}
